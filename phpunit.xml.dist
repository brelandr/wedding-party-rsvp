<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	convertDeprecationsToExceptions="true"
	>
	<!-- WordPress test suite. Set WP_TESTS_DIR to vendor/wp-phpunit/wp-phpunit or a wordpress-develop tests/phpunit tree. Groups: all, rsvp, guestbook, rest. -->
	<php>
		<env name="WP_TESTS_DIR" value="" force="false"/>
		<env name="WP_PHPUNIT__TESTS_CONFIG" value="tests/wp-tests-config.php" force="false"/>
	</php>
	<testsuites>
		<testsuite name="Wedding Party RSVP">
			<directory suffix=".php">./tests</directory>
			<exclude>./tests/bootstrap.php</exclude>
			<exclude>./tests/wp-tests-config.php</exclude>
		</testsuite>
	</testsuites>
</phpunit>
