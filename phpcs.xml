<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Wedding Party RSVP" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>PHPCS configuration for Wedding Party RSVP</description>
	
	<file>.</file>
	
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>*/includes/lib/fpdf/*</exclude-pattern>
	<exclude-pattern>/svn-checkout/*</exclude-pattern>
	<exclude-pattern>/assets/blueprints/*</exclude-pattern>
	<exclude-pattern>/assets/js/*</exclude-pattern>
	<exclude-pattern>/assets/src/*</exclude-pattern>
	<exclude-pattern>/src/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>
	<exclude-pattern>*.zip</exclude-pattern>
	
	<rule ref="WordPress">
		<properties>
			<property name="text_domain" type="array">
				<element value="wedding-party-rsvp"/>
			</property>
		</properties>
	</rule>
	
	<rule ref="WordPress.WP.I18n.TextDomainMismatch">
		<severity>0</severity>
	</rule>

	<!-- The main plugin file must keep the plugin-slug filename required by WordPress. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/wedding-party-rsvp\.php$</exclude-pattern>
	</rule>

	<!-- Main loader and ICS module intentionally expose global helper functions alongside their class. -->
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>/wedding-party-rsvp\.php$</exclude-pattern>
		<exclude-pattern>/includes/class-wgrsvp-ics\.php$</exclude-pattern>
	</rule>
</ruleset>
